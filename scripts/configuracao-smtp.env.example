# Copie para .env.smtp.local na raiz; esse arquivo privado é ignorado pelo Git.
# Não usar prefixo VITE. Não compartilhar o arquivo preenchido.
SUPABASE_PROJECT_REF=yzcjksiowgcncpxttoxt
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
# Chave SMTP/API do Resend: obtenha no provedor; não é a chave da OpenAI ou Supabase.
SMTP_PASS=
# Endereço no domínio que VOCÊ verificou no provedor. Exemplo não funcional:
SMTP_FROM_EMAIL=acesso@seu-dominio.com
SMTP_FROM_NAME=PCM Direto
# Opcional na simulação; necessário para aplicar via script administrativo.
# Token pessoal do Supabase (sbp_...), guardado somente neste arquivo privado.
SUPABASE_ACCESS_TOKEN=
