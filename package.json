{
  "name": "pcm-direto",
  "version": "0.1.0",
  "description": "Gerador de PCM aberto, em português: lista de equipamentos entra, plano de manutenção sai em .xlsx e .docx. Roda 100% no navegador.",
  "license": "MIT",
  "author": "Thiago Oliveira Lima",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "verificar": "npm run lint && npm test && npm run build",
    "test:navegador": "node scripts/verificar-navegador.mjs",
    "test:catalogo:banco": "node scripts/verificar-catalogo-banco.mjs",
    "test:catalogo:navegador": "node scripts/verificar-catalogo-navegador.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "docx": "^9.12.0",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
